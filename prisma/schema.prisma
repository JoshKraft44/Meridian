generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  SHOPIFY
  ETSY
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
  REFUNDED
}

enum FeeType {
  SHOPIFY_PROCESSING
  SHOPIFY_APP
  SHOPIFY_OTHER
  PAYMENT_PROCESSING
}

enum ExpenseCategoryType {
  SOURCING
  PACKAGING
  OTHER
}

enum BillingFrequency {
  MONTHLY
  ANNUALLY
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Order {
  id String @id @default(cuid())
  platform Platform
  platformOrderId String
  orderName String?
  orderDate DateTime
  grossRevenueCents Int
  subtotalPriceCents Int?
  totalDiscountsCents Int?
  shippingChargedCents Int
  shippingCostCents Int?
  shippingCostOverrideCents Int?
  taxesCents Int
  cogsCents Int @default(0)
  status OrderStatus @default(OPEN)

  customerName String?
  customerEmail String?
  customerPhone String?

  shippingName String?
  shippingAddress1 String?
  shippingAddress2 String?
  shippingCity String?
  shippingProvince String?
  shippingProvinceCode String?
  shippingZip String?
  shippingCountry String?
  shippingCountryCode String?

  fulfillmentStatus String?
  note String?
  tags String?
  cancelReason String?
  cancelledAt DateTime?
  closedAt DateTime?
  discountCodes Json?
  paymentGateway String?

  feeLines FeeLine[]
  refunds Refund[]
  lineItems LineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, platformOrderId])
  @@index([orderDate])
  @@index([platform])
  @@index([status])
}

model LineItem {
  id                String  @id @default(cuid())
  orderId           String
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  platformItemId    String
  platformProductId String?
  title             String
  variantTitle      String?
  quantity          Int
  priceCents        Int
  sku               String?
  requiresShipping  Boolean @default(true)
  grams             Int?

  @@index([orderId])
}

model FeeLine {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type FeeType
  amountCents Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([type])
}

model Refund {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  platformRefundId String
  refundDate DateTime
  amountCents Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([platformRefundId])
}

model Payout {
  id String @id @default(cuid())
  platform Platform
  platformPayoutId String

  payoutDate DateTime
  totalCents Int
  chargesFeesCents Int
  adjustmentsFeesCents Int
  refundsFeesCents Int

  createdAt DateTime @default(now())

  @@unique([platform, platformPayoutId])
  @@index([payoutDate])
}

model ExpenseEvent {
  id String @id @default(cuid())
  eventDate DateTime
  category ExpenseCategoryType
  amountCents Int
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventDate])
  @@index([category])
}

model Subscription {
  id          String           @id @default(cuid())
  name        String
  amountCents Int
  frequency   BillingFrequency
  platform    Platform?
  startDate   DateTime
  endDate     DateTime?
  notes       String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([startDate])
}

model Product {
  id                String         @id @default(cuid())
  platform          Platform
  platformProductId String
  title             String
  vendor            String?
  productType       String?
  status            String?
  tags              String?
  description       String?
  sku               String?
  priceCents        Int?
  weightGrams       Int?
  lengthCm          Float?
  widthCm           Float?
  heightCm          Float?

  linkedProductId String?  @unique
  linkedProduct   Product? @relation("ProductLink", fields: [linkedProductId], references: [id])
  linkedBy        Product? @relation("ProductLink")

  images    ProductImage[]
  notes     ProductNote[]
  creatives Creative[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, platformProductId])
  @@index([platform])
  @@index([sku])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  src       String
  filename  String?
  alt       String?
  position  Int
  width     Int?
  height    Int?

  @@index([productId])
  @@index([filename])
}

model ProductNote {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([productId])
}

model SyncRun {
  id String @id @default(cuid())
  platform Platform

  startedAt DateTime
  finishedAt DateTime?
  status SyncStatus @default(RUNNING)

  ordersUpserted Int @default(0)
  payoutsSynced Int @default(0)
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([platform])
  @@index([startedAt])
}

model ShopifyConnection {
  id String @id @default(cuid())
  accessToken String
  shop String

  connectedAt DateTime @default(now())
  lastSyncedAt DateTime?

  @@unique([shop])
}

model EtsyConnection {
  id           String    @id @default(cuid())
  shopId       String    @unique
  shopName     String?
  accessToken  String
  refreshToken String
  expiresAt    DateTime

  connectedAt  DateTime  @default(now())
  lastSyncedAt DateTime?
}

model Settings {
  id String @id @default(cuid())
  accentColor String @default("#c0392b")
  excludeTaxesFromGross Boolean @default(false)

  metaLastSyncedAt  DateTime?
  metaLastSyncError String?

  updatedAt DateTime @updatedAt
}

model MetaCampaign {
  id                  String    @id // Meta's campaign id
  name                String
  objective           String?
  status              String? // what it's set to: ACTIVE, PAUSED, ...
  effectiveStatus     String? // what Meta is actually doing with it
  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?
  createdTime         DateTime?

  days MetaCampaignDay[]

  syncedAt DateTime @updatedAt
}

// Meta-attributed numbers only. Never mix with Shopify-confirmed revenue.
model MetaCampaignDay {
  id         String       @id @default(cuid())
  campaignId String
  campaign   MetaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date       DateTime     @db.Date // ad account timezone (America/Edmonton)

  spendCents             Int
  impressions            Int
  clicks                 Int
  reach                  Int
  metaPurchases          Int
  metaPurchaseValueCents Int

  @@unique([campaignId, date])
  @@index([date])
}

enum CreativeKind {
  IMAGE
  VIDEO
}

// Photos/videos for posts and ads. Hosted on Shopify Files so Meta can fetch them by URL.
model Creative {
  id            String       @id @default(cuid())
  kind          CreativeKind
  url           String
  shopifyFileId String       @unique
  filename      String
  sizeBytes     Int?
  width         Int?
  height        Int?
  tags          String[]
  notes         String?

  // The antler in the shot, if it's a specific listing. Used to flag ads once it sells.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  posts SocialPostMedia[]

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([productId])
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
}

enum PostFormat {
  SINGLE // one photo
  CAROUSEL // 2-10 photos
  REEL // one video
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

// One row per platform. Composing for IG + FB makes two posts.
model SocialPost {
  id           String         @id @default(cuid())
  platform     SocialPlatform
  format       PostFormat
  caption      String
  status       PostStatus     @default(DRAFT)
  scheduledFor DateTime?
  publishedAt  DateTime?
  externalId   String? // IG media id / FB post id
  permalink    String?
  error        String?
  attempts     Int            @default(0)

  // Rows composed together (IG + FB versions of one idea) share a group
  groupId String?

  // Drafts written by Claude for review: why it was suggested, and notes back for a rewrite
  suggestedBy String?
  rationale   String?
  feedback    String?

  media SocialPostMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([groupId])
}

model SocialPostMedia {
  postId     String
  post       SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  creativeId String
  creative   Creative   @relation(fields: [creativeId], references: [id], onDelete: Restrict)
  position   Int

  @@id([postId, position])
}

// Scene prompts for the image studio. The name/description is what shows on the button;
// the prompt is the full text sent to the model ({antlers} is filled in per product).
model ScenePreset {
  id          String    @id @default(cuid())
  name        String
  description String
  prompt      String
  builtIn     Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// AI scene images generated from a product's photos. Kept until added to the product,
// saved to the library, or discarded.
model GeneratedImage {
  id             String   @id @default(cuid())
  productGid     String
  sourceMediaIds String[]
  presetName     String
  prompt         String
  model          String
  imageSize      String   @default("1K")
  aspectRatio    String
  bytes          Bytes
  mimeType       String
  status         String   @default("NEW") // NEW, ADDED, DISCARDED
  shopifyMediaId String?
  creativeId     String?
  createdAt      DateTime @default(now())
  // Bumped by anything done to the image (discard, add, library), so the picker can sort by last edit
  updatedAt      DateTime @default(now()) @updatedAt

  // Amendments: an edit of an earlier generated image, with the change that was asked for.
  // prompt stays the original scene prompt so the whole chain can be replayed.
  parentId    String?
  instruction String?

  @@index([productGid, createdAt])
}

// Last time a product was opened in the studio
model StudioProductView {
  productGid String   @id
  viewedAt   DateTime @default(now())

  @@index([viewedAt])
}
